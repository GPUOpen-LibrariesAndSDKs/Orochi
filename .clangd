# ===========================================================================
# Compile flags adjustments
# ===========================================================================
CompileFlags:
  # Remove flags that are invalid for clangd's parser:
  #   -fPIC   : emitted by premake for Unix but irrelevant for clangd analysis
  #   /wd<id> : MSVC warning-disable flags that clang++ treats as file paths
  Remove:
    - -fPIC
    - /wd*
  # premake's compile_commands exporter omits externalincludedirs, so gtest
  # headers are not found without this. Paths that don't resolve are ignored.
  # -Wno-unused-command-line-argument : quiet noise from leftover -c / -o flags
  # -Wno-deprecated : silence "treating 'c-header' input as 'c++-header'"
  Add:
    - -isystemUnitTest/contrib/gtest-1.6.0
    - -Wno-unused-command-line-argument
    - -Wno-deprecated

# ===========================================================================
# Diagnostics and linting
# ===========================================================================
Diagnostics:
  ClangTidy:
    Add:
      - modernize-use-override
      - modernize-use-nullptr
      - readability-redundant-smartptr-get
      - performance-unnecessary-copy-initialization
    Remove:
      - modernize-use-trailing-return-type
  # Warn on headers that are included but never used
  UnusedIncludes: Strict

# ===========================================================================
# Indexing, completion, and hover
# ===========================================================================
Index:
  Background: Build

Completion:
  # Disable global-scope completion to keep performance predictable
  AllScopes: false

Hover:
  # Show the underlying type behind typedef/using aliases
  ShowAKA: true

# ===========================================================================
# Header file fallback
# ===========================================================================
# For headers without a compile_commands.json entry (e.g. Test/Common.h),
# force C++20 mode with workspace include path.
---
If:
  PathMatch: .*\.h$
CompileFlags:
  Add:
    - -xc++-header
    - -std=c++20
    - -I.
